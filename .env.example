NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43147
# Hosted Auth Redirect URLs must include this origin and the www/apex alias at /auth/callback.

# Prisma / Postgres. Table CRUD goes through Prisma, not Supabase PostgREST.
# Schema changes go through prisma migrate, not supabase.
# Vercel preview and production both need these postgres URLs at runtime.
# prisma generate may use the local placeholder in prisma.config.ts. That is build-only.
# Prisma uses DATABASE_URL (pooler) then DIRECT_URL.
# Mastra memory uses DIRECT_URL (session Postgres, port 5432) then DATABASE_URL.
# NEXT_PUBLIC_SUPABASE_URL is https. It is not a database URL. Never pass it to Prisma or Mastra.
# Apply schema with: pnpm prisma:migrate:deploy
DATABASE_URL=postgresql://
DIRECT_URL=postgresql://

# Optional. GitHub OAuth for local `supabase start`.
# Callback: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# Optional. X OAuth 2.0 (provider id `x`, not twitter).
# Callback: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_X_SECRET=

# contents:write + pull_requests:write. Missing token returns paste-ready JSON.
ORGBOTS_GITHUB_TOKEN=

# Sarvam. Key is not a model id. https://dashboard.sarvam.ai
SARVAM_API_KEY=
MASTRA_MODEL=sarvam/sarvam-105b

# PostHog analytics only. Never used to render the visits number on cards.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
