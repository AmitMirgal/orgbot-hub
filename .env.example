NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43147

# Prisma / Postgres. Schema changes go through prisma migrate, not supabase.
# DATABASE_URL can be the pooler. DIRECT_URL must be the direct Postgres port (5432).
DATABASE_URL=
DIRECT_URL=

# Optional. GitHub OAuth for local `supabase start`.
# Callback: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# contents:write + pull_requests:write. Missing token returns paste-ready JSON.
ORGBOTS_GITHUB_TOKEN=

# Sarvam. Key is not a model id. https://dashboard.sarvam.ai
SARVAM_API_KEY=
MASTRA_MODEL=sarvam/sarvam-105b

# PostHog analytics only. Never used to render the visits number on cards.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
